# set File
# set netlist(.v)
-n ./input/circuit/s38584_C.v 

# set fault list(.txt)
-f ./input/fault/s38584_C_rpr_10.txt

# set xor-tap list(.txt)
-x ./input/xor_tap/tap_64.txt

# set scan-chain(.txt)
-c ./input/scan_chain/s38584_C_sc_64.txt

# set necessary(.txt)
-e ./input/necessary/s38584_C_nece.txt

# set graphlog(.txt)
-g ./output/graphlog/s38584_C_Graphlog.txt

# set log(.txt)
-l ./output/log/s38584_C_log.txt

# set pin(.txt)
-p ./output/pin/s38584_C_pin.txt

# set seed set(.txt)
-s ./output/seed/s38584_C_seed.txt

# set test pattern(.txt)
-t ./output/test_pattern/s38584_C_tp.txt

# set untestable fault(.txt)
#-u ./output/untestable/s38584_C_unsat.txt


# set target fault mode
#-o SINGLE
-o MULTIPLE

# set generation mode
-m SEED
#-m TEST


