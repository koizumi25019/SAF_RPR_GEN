# set File
# set netlist(.v)
-n ./input/circuit/b14_C.v 

# set fault list(.txt)
-f ./input/fault/b14_C_rpr_10.txt

# set xor-tap list(.txt)
-x ./input/xor_tap/tap_32.txt

# set scan-chain(.txt)
-c ./input/scan_chain/b14_C_sc_32.txt

# set necessary(.txt)
-e ./input/necessary/b14_C_nece.txt

# set graphlog(.txt)
-g ./output/graphlog/b14_C_Graphlog.txt

# set log(.txt)
-l ./output/log/b14_C_log.txt

# set pin(.txt)
-p ./output/pin/b14_C_pin.txt

/** set seed set */
-s ./output/seed/b14_C_seed.txt

/** set test pattern */
-t ./output/test_pattern/b14_C_tp.txt

# set untestable fault(.txt)
-u ./output/untestable/b14_C_untest.txt


# set target fault mode
#-o SINGLE
-o MULTIPLE

# set generation mode
-m SEED
#-m TEST


