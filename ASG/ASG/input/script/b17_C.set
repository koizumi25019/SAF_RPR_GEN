# set File
# set netlist(.v)
-n ./input/circuit/b17_C.v 

# set fault list(.txt)
-f ./input/fault/b17_C_rpr_1.txt
#-f ./input/fault/b17_C_fault.txt

# set xor-tap list(.txt)
-x ./input/xor_tap/tap_64.txt

# set scan-chain(.txt)
-c ./input/scan_chain/b17_C_sc_64.txt

# set necessary(.txt)
#-e ./input/necessary/b17_C_nece.txt

# set graphlog(.txt)
-g ./output/graphlog/b17_C_Graphlog.txt

# set log(.txt)
-l ./output/log/b17_C_log.txt

# set pin(.txt)
-p ./output/pin/b17_C_pin.txt

# set seed set(.txt)
-s ./output/seed/b17_C_seed.txt

# set test pattern(.txt)
-t ./output/test_pattern/b17_C_tp.txt

# set untestable fault(.txt)
-u ./output/untestable/b17_C_untest.txt


# set target fault mode
#-o SINGLE
-o MULTIPLE

# set generation mode
-m SEED
#-m TEST



