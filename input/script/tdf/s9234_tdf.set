# LOC transition delay faults; run from build/
-tdf
# Requires the original sequential netlist with DFFs (not s9234_C.v).
-net ../input/circuit/tdf/s9234.v
# -fault omitted: generate representative STR/STF faults automatically.
-limit 30
-jobs 12
-fdp ../output/tdf/limit30/fdp/s9234_tdf.csv
-log ../output/tdf/limit30/log/s9234_tdf.txt
