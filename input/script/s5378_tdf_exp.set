# set File — 遷移故障（TDF, LOC方式）実験。SAF側の s5378_C.set と同じ流儀:
# 全代表故障を自動生成（等価故障解析込み）、テストキューブ上限30で打ち切り運用。
-tdf

# set netlist(.v) — DFF入り順序回路
-net ../input/circuit/s5378.v

# set fault list(.txt)
# -fault は書かない → 全代表故障を自動生成（等価故障解析込み）

# set log(.txt)
-log ../output/limit30/log/s5378_tdf_exp_log.txt

# set fdp result(.csv)
-fdp ../output/limit30/fdp/s5378_tdf_exp_fdp.csv

-limit 30
