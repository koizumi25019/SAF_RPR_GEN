# set File
# set netlist(.v)
-net ../input/circuit/s5378_C.v 

# set fault list(.txt)
-fault ../input/fault/s5378_C_test.txt

# set log(.txt)
-log ../output/limit10000/log/s5378_C_test_log.txt


# set fdp result(.csv)
-fdp ../output/limit10000/fdp/s5378_C_test_fdp.csv

# cube_analysis(.txt)
-cube_analysis ../output/limit10000/cube_analysis/s5378_C_test_cube_analysis.csv

-limit 10000


