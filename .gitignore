# Python・開発ツールのキャッシュ
__pycache__/
*.pyc
node_modules/

# 一時ファイル・ログ（output/配下は末尾のルールでGit管理する）
*.tmp
*~
~$*
*.[Cc]ache
!?*.[Cc]ache/
*.log
*.binlog
[Ll]og/
[Ll]ogs/

# 再生成できる実験データ・バイナリ資料
*.progress
*.stderr
*.runinfo
*.pkl
*.pptx

# ASGブランチから切り替えた後に残る生成物
/ASG/**/output/
/ASG/src/main/*.txt
/ASG/build/*.txt
/ASG/ASG/input/necessary/
/ASG/ASG/tools/scip/*.dll
/ASG/ASG/tools/scip/*.exe

# verificationブランチのビルド・実行結果
/verification/**/build/
/verification/**/runs/
/verification/**/vendor/
/verification/**/*.csv
# 比較表などの実験記録はGit管理する。
!/verification/**/results/*.csv
# 過去に巨大化した生成物は、上のresults例外より後で除外する。
/verification/gt_bdd/results/g14.fdp.csv

# ローカル配置の外部ツールとWindowsのダウンロード付加情報
# CaDiCaLの生成物はexternal/cadical/.gitignoreで管理する。
/external/hall/
*:Zone.Identifier

# SAF/TDFの実験結果はログ・キューブを含めてGit管理する。
# 上の汎用ルールに優先させるため、例外は最後に置く。
!/output/
!/output/**
