{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug 起動",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ASG/src/main",
            "args": ["-set", "../input/script/b15.set"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/ASG/src",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "gdb の再フォーマットを有効にする",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // ★ここはDebug用のビルドを呼ぶ
            "preLaunchTask": "C/C++: gcc Debug ビルド (プロジェクト全体)",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        // ▼▼▼ ここから下を追加 ▼▼▼
        {
            "name": "Release 実行",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ASG/src/main",
            "args": ["-set", "../input/script/s27_C.set"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/ASG/src",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "C/C++: gcc Release ビルド (プロジェクト全体)",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}