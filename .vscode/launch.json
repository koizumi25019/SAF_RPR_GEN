{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug 起動",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ASG/build/main_debug",
            "args": ["-set", "../input/script/s5378_C_test.set"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/ASG/src",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "gdb の再フォーマットを有効にする",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Release 実行",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ASG/build/main_release",
            "args": ["-set", "../input/script/s5378_C.set"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/ASG/src",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}