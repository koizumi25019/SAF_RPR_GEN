{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug 起動",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/main_debug",
            "args": ["-set", "../data/script/c17a.set"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src",
            "environment": [],
            "externalConsole": false,//別のウィンドウにターミナルをポップアップするか否か
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "gdb の再フォーマットを有効にする",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",//debugする前に自動でbuildをする
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Release 実行",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/main_release",
            "args": ["-set", "../data/script/s5378_C.set"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}