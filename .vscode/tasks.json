{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc Debug ビルド (プロジェクト全体)",
            "command": "/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/ASG/src/*.c",
                "${workspaceFolder}/ASG/src/asg/*.c",
                "${workspaceFolder}/ASG/src/asg/opb/*.c",
                "${workspaceFolder}/ASG/src/asg/opb/clasp/*.c",
                "${workspaceFolder}/ASG/src/lib/*.c",
                "${workspaceFolder}/ASG/src/netlist/*.c",
                "${workspaceFolder}/ASG/src/opt/*.c",
                "-o",
                "${workspaceFolder}/ASG/src/main",
                "-I/home/20koizumi/src/cadical/src",
                "-L/home/20koizumi/src/cadical/build",
                "-I${env:HOME}/local/include",
                "-L${env:HOME}/local/lib",
                "-lcadical",
                "-lcudd",
                "-lgmp",
                "-lm",
                "-lstdc++"
            ],
            "options": {
                "cwd": "${workspaceFolder}/ASG/src"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "プロジェクトのすべてのCファイルをコンパイルし、デバッグ情報を付与します。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc Release ビルド (プロジェクト全体)",
            "command": "/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-O3",
                "-DNDEBUG",
                "${workspaceFolder}/ASG/src/*.c",
                "${workspaceFolder}/ASG/src/asg/*.c",
                "${workspaceFolder}/ASG/src/asg/opb/*.c",
                "${workspaceFolder}/ASG/src/asg/opb/clasp/*.c",
                "${workspaceFolder}/ASG/src/lib/*.c",
                "${workspaceFolder}/ASG/src/netlist/*.c",
                "${workspaceFolder}/ASG/src/opt/*.c",
                "-o",
                "${workspaceFolder}/ASG/src/main",
                "-I/home/20koizumi/src/cadical/src",
                "-L/home/20koizumi/src/cadical/build",
                "-I${env:HOME}/local/include",
                "-L${env:HOME}/local/lib",
                "-lcadical",
                "-lcudd",
                "-lgmp",
                "-lm",
                "-lstdc++"
            ],
            "options": {
                "cwd": "${workspaceFolder}/ASG/src"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "最適化を最大化して実行ファイルを生成します。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc アクティブなファイルのビルド",
            "command": "/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-I/home/20koizumi/src/cadical/src",
                "-L/home/20koizumi/src/cadical/build",
                "-I${env:HOME}/local/include",
                "-L${env:HOME}/local/lib",
                "-lcadical",
                "-lcudd",
                "-lgmp",
                "-lm",
                "-lstdc++"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "現在開いているファイルのみをビルドします（ヘッダーエラー解消用）。"
        }
    ]
}